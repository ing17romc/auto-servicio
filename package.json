{
  "name": "auto-servicio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test tests/domain.test.mjs tests/portal.integration.test.mjs",
    "test:e2e": "node --test tests/browser.test.mjs",
    "db:setup": "node --conditions=react-server --env-file-if-exists=.env.local tools/db-setup.mjs",
    "admin:bootstrap": "node --conditions=react-server --env-file-if-exists=.env.local tools/bootstrap-admin.mjs",
    "openspec": "npx --yes @fission-ai/openspec@2.1.1",
    "mcp:setup": "npm --prefix tools/mcp ci --no-audit --no-fund",
    "skills:check": "node tools/verify-skills.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.27",
    "express": "5.3.0",
    "mongodb": "6.21.0",
    "mongoose": "9.13.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "mongodb-memory-server": "11.4.0"
  }
}
